# Glimmer (local via Ollama)
OLLAMA_HOST=http://localhost:11434
GLIMMER_MODEL=muse-glimmer
FALLBACK_MODEL=llama3.1:8b

# Muse Spark (optional comparison baseline)
MUSE_SPARK_API_KEY=
MUSE_SPARK_BASE_URL=https://api.meta.ai/v1
MUSE_SPARK_MODEL=muse-spark-1.2

# Judge
ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-sonnet-4-6
TAVILY_API_KEY=
BRAVE_API_KEY=
SERP_API_KEY=
MOCK_JUDGE=auto
# when MOCK_JUDGE=1 forces deterministic mock retriever (CI)
# when missing keys, retriever falls back to mock automatically

# Training
HF_TOKEN=
WANDB_API_KEY=
TRAINER_BACKEND=mock
# mock | unsloth | axolotl | ollama

# Flywheel
FLYWHEEL_CRON=0 3 * * *
FLYWHEEL_MAX_ITERS=10
FLYWHEEL_PROMOTION_P=0.05

# Glimmer CLI sibling (for hill-climb comparison)
GLIMMER_CLI_PATH=../glimmer-cli
